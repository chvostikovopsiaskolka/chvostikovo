        "CHECK (((length(TRIM(BOTH FROM dog_age_text)) >= 1) AND (length(TRIM(BOTH FROM dog_age_text)) <= 80)))",
        "CHECK ((length(dog_allergies) <= 3000))",
        "CHECK (((length(TRIM(BOTH FROM dog_breed)) >= 1) AND (length(TRIM(BOTH FROM dog_breed)) <= 200)))",
        "CHECK (((length(TRIM(BOTH FROM dog_name)) >= 1) AND (length(TRIM(BOTH FROM dog_name)) <= 160)))",
        "CHECK (((dog_order >= 1) AND (dog_order <= 2)))",
        "CHECK ((dog_sex = ANY (ARRAY['male'::text, 'female'::text])))",
        "CHECK (((length(TRIM(BOTH FROM dog_temperament)) >= 1) AND (length(TRIM(BOTH FROM dog_temperament)) <= 3000)))",
        "CHECK (((dog_weight_kg > (0)::numeric) AND (dog_weight_kg <= (150)::numeric)))",
        "CHECK (((length(TRIM(BOTH FROM interest_reason)) >= 1) AND (length(TRIM(BOTH FROM interest_reason)) <= 250)))",
        "PRIMARY KEY (submission_id, dog_order)",
        "FOREIGN KEY (submission_id) REFERENCES web_form_submissions(id) ON DELETE CASCADE"
      ]
    }
  ]
}
